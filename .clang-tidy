# What `tools/lint.sh` holds the engine's C++ to. The numbers are the project's rules:
# small functions, shallow logic, every number named.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  performance-*,
  readability-function-size,
  readability-function-cognitive-complexity,
  readability-magic-numbers,
  readability-else-after-return,
  readability-simplify-boolean-expr,
  readability-redundant-control-flow,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-misleading-indentation,
  modernize-use-nullptr,
  modernize-use-override,
  misc-unused-parameters,
  misc-unused-using-decls,
  misc-redundant-expression
HeaderFilterRegex: '.*/(src|tests)/.*'
CheckOptions:
  # A function fits on a small part of a screen and does one thing.
  readability-function-size.LineThreshold: 15
  readability-function-size.StatementThreshold: 12
  readability-function-size.BranchThreshold: 4
  readability-function-size.NestingThreshold: 2
  readability-function-size.ParameterThreshold: 6
  # Few ifs, never deep: logic that reads top to bottom.
  readability-function-cognitive-complexity.Threshold: 8
  readability-function-cognitive-complexity.IgnoreMacros: true
  # Every number has a name; 0, 1 and -1 speak for themselves.
  readability-magic-numbers.IgnoredIntegerValues: '0;1'
  readability-magic-numbers.IgnoredFloatingPointValues: '0.0;1.0'
  readability-magic-numbers.IgnorePowersOf2IntegerValues: false
