# Script mode: embeds text files into a C++ header as {relative path, contents} pairs.
#   cmake -DOUTPUT=<header> -DROOT=<dir> -DNAME=<array name> -DSOURCES="a;b" -P EmbedFiles.cmake
set(content "// Generated by cmake/EmbedFiles.cmake. Do not edit.\n#pragma once\n\n")
string(APPEND content "namespace redgem::generated {\n\n")
string(APPEND content "struct EmbeddedFile {\n  const char* path;\n  const char* contents;\n};\n\n")
set(entries "")
set(index 0)
foreach(source IN LISTS SOURCES)
  # Character arrays avoid the compiler's string-literal size limit and raw-string delimiters.
  file(READ "${source}" bytes HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${bytes}")
  file(RELATIVE_PATH relative "${ROOT}" "${source}")
  set(symbol "${NAME}_${index}")
  string(APPEND content "inline constexpr char ${symbol}[] = {${bytes}'\\0'};\n")
  string(APPEND entries "  {\"${relative}\", ${symbol}},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "\ninline constexpr EmbeddedFile ${NAME}[] = {\n${entries}")
string(APPEND content "};\n\n}  // namespace redgem::generated\n")
file(WRITE "${OUTPUT}" "${content}")
