# Script mode: builds every file of a folder into the program, whatever it holds (text, models,
# sounds), as {path inside the folder, where its bytes are}. The header it writes is for one
# source file alone: it holds the files themselves (see core/embed.hpp).
#   cmake -DOUTPUT=<header> -DROOT=<dir> -DNAME=<function name> -DSOURCES="a;b" -P EmbedFolder.cmake
set(content "// Generated by cmake/EmbedFolder.cmake. Do not edit.\n#pragma once\n\n")
string(APPEND content "#include <vector>\n\n#include \"core/embed.hpp\"\n\n")
set(index 0)
set(entries "")
foreach(source IN LISTS SOURCES)
  file(RELATIVE_PATH relative "${ROOT}" "${source}")
  set(symbol "redgem_embedded_${NAME}_${index}")
  string(APPEND content "REDGEM_EMBED_FILE(${symbol}, \"${source}\");\n")
  string(APPEND entries "      {\"${relative}\", REDGEM_EMBEDDED_FILE(${symbol})},\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "\nnamespace redgem::generated {\n\n")
string(APPEND content "struct FolderFile {\n  const char* path;\n  EmbeddedFile file;\n};\n\n")
string(APPEND content "inline std::vector<FolderFile> ${NAME}() {\n  return {\n${entries}  };\n}\n\n")
string(APPEND content "}  // namespace redgem::generated\n")
file(WRITE "${OUTPUT}" "${content}")
