# Script mode: concatenates Ruby sources into a C++ header with a raw string literal.
#   cmake -DOUTPUT=<header> -DSOURCES="a.rb;b.rb" -P EmbedRuby.cmake
# Optional: -DNAMESPACE=<C++ namespace> -DNAME=<array name> -DFOLDER=<what the files are said to
# be in, in Ruby's error messages>. Without them, the header is the engine's prelude.
if(NOT NAMESPACE)
  set(NAMESPACE "redgem::generated")
endif()
if(NOT NAME)
  set(NAME "kPreludeSources")
endif()
if(NOT FOLDER)
  set(FOLDER "engine")
endif()
set(content "// Generated by cmake/EmbedRuby.cmake. Do not edit.\n#pragma once\n\n")
string(APPEND content "namespace ${NAMESPACE} {\n\n")
string(APPEND content "struct RubySource {\n  const char* file_name;\n  const char* code;\n};\n\n")
string(APPEND content "inline constexpr RubySource ${NAME}[] = {\n")
foreach(source IN LISTS SOURCES)
  file(READ "${source}" code)
  get_filename_component(name "${source}" NAME)
  string(APPEND content "  {\"${FOLDER}/${name}\", R\"RUBY_PRELUDE(${code})RUBY_PRELUDE\"},\n")
endforeach()
string(APPEND content "};\n\n}  // namespace ${NAMESPACE}\n")
file(WRITE "${OUTPUT}" "${content}")
