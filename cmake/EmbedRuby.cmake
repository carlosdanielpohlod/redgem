# Script mode: concatenates Ruby sources into a C++ header with a raw string literal.
#   cmake -DOUTPUT=<header> -DSOURCES="a.rb;b.rb" -P EmbedRuby.cmake
set(content "// Generated by cmake/EmbedRuby.cmake. Do not edit.\n#pragma once\n\n")
string(APPEND content "namespace redgem::generated {\n\n")
string(APPEND content "struct RubySource {\n  const char* file_name;\n  const char* code;\n};\n\n")
string(APPEND content "inline constexpr RubySource kPreludeSources[] = {\n")
foreach(source IN LISTS SOURCES)
  file(READ "${source}" code)
  get_filename_component(name "${source}" NAME)
  string(APPEND content "  {\"engine/${name}\", R\"RUBY_PRELUDE(${code})RUBY_PRELUDE\"},\n")
endforeach()
string(APPEND content "};\n\n}  // namespace redgem::generated\n")
file(WRITE "${OUTPUT}" "${content}")
