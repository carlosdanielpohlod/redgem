  def self.distance: (GameObject actor, GameObject | Interactable target) -> Float
  # degrees between where the actor faces and where the target is, across the ground
  %a{redgem:experimental}
  def self.angle_to: (GameObject actor, GameObject | Interactable target) -> Float
end

# Whether one thing can see another: a ray to it hits nothing else first.
%a{redgem:experimental}
module LineOfSight
  # whether a ray from a point to a point on the target hits nothing but the target (what is under it, or what carries it) first
