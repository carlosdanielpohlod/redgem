  def name: () -> String
  # the I18n key of its title
  %a{redgem:experimental}
  def title_key: () -> String
  # the I18n key of its description, or nil
  %a{redgem:experimental}
  def description_key: () -> (String | nil)
  # the stage it starts at
  %a{redgem:experimental}
  def start: () -> String
  # the stage of that id (its line in the file), or nil
  %a{redgem:experimental}
  def stage: (String id) -> (Hash[String, untyped] | nil)
  # whether it has a stage of that id
  %a{redgem:experimental}
  def stage?: (String | nil id) -> bool
  # the ids of its stages
  %a{redgem:experimental}
  def stage_ids: () -> Array[String]
  # whether reaching that stage completes the quest
  %a{redgem:experimental}
  def end?: (String | nil id) -> bool
  # the objectives of a stage, as the file has them
  %a{redgem:experimental}
  def objectives: (String | nil id) -> Array[Hash[String, untyped]]
end

# A behaviour on the player's hero: tells the quests when it reaches a go_to objective's place, asks the game's checks on the host, and shows where the tracked quest's objectives happen (QuestMarkers).
%a{redgem:experimental}
class QuestTracker < Behaviour
end

# Where the tracked quest's objectives happen, on this machine's screen: a marker over each place the camera sees and a pointer at the edge toward one it does not; the game turns them off, restyles them, locates objectives or draws them.
%a{redgem:experimental}
module QuestMarkers
  # whether this machine shows the markers and pointers (true unless the game said)
  %a{redgem:experimental}
  def self.enabled: () -> bool
  # shows them or not, for the whole run
  %a{redgem:experimental}
  def self.enabled=: (bool shown) -> bool
  # changes some of the looks (color:, size:, pointer_size:, margin:, height:, distance:, image:); returns them all
  %a{redgem:experimental}
  def self.style: (**untyped changes) -> Hash[Symbol, untyped]
  # the looks back to the engine's
  %a{redgem:experimental}
  def self.reset_style: () -> Hash[Symbol, untyped]
  # |objective| where it happens: a GameObject, a Vector3, or nil for the object it names (until the next level)
  %a{redgem:experimental}
  def self.locate: () { (Quests::Objective) -> untyped } -> void
  # |mark| draws each mark as the game wants, in the place of the engine's dots (until the next level)
  %a{redgem:experimental}
  def self.draw: () { (QuestMarkers::Mark) -> void } -> void
  # what shows now: a mark for each objective under way of the tracked quest that has a place
  %a{redgem:experimental}
  def self.marks: () -> Array[QuestMarkers::Mark]
  # where a pointer sits toward a direction from the middle of a screen: on the way to it, margin inside the edge
  %a{redgem:experimental}
  def self.edge_point: ([Float, Float] direction, Numeric width, Numeric height, ?Numeric margin) -> [Float, Float]
  # whether a point (nil: behind the camera) is on a screen of that size
  %a{redgem:experimental}
  def self.on_screen?: ([Numeric, Numeric] | nil spot, Numeric width, Numeric height) -> bool
end

# One place QuestMarkers shows: a marker on the screen, or a pointer at its edge.
%a{redgem:experimental}
class QuestMarkers::Mark
  # the objective it shows
