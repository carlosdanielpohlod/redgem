  def y: () -> Float
  # true for a pointer at the edge of the screen (the camera does not show the place)
  %a{redgem:experimental}
  def pointer: () -> bool
  # a pointer's way to its place on the screen, of length 1 (nil for a marker)
  %a{redgem:experimental}
  def direction: () -> ([Float, Float] | nil)
  # from the hero to the place
  %a{redgem:experimental}
  def meters: () -> Float
end

# A behaviour: shows the player's conversation at the bottom of the screen, with its choices; keyboard, gamepad and touch go on, choose and leave.
