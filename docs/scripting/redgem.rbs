# A behaviour: an NPC's state machine, with states, transitions, guards, timers and events.
%a{redgem:experimental}
class Brain < Behaviour
  # declares a state, with its hooks (enter:, update:, exit:; enter_<name> and the like unless said)
  %a{redgem:experimental}
  def self.state: (Symbol | String name, **Symbol | Proc hooks) -> void
  # the state it starts in (the first declared unless said); with a name, sets it
  %a{redgem:experimental}
  def self.initial: (?Symbol | String | nil name) -> (Symbol | nil)
  # declares a way from a state (a list, or :any) to another: on: an event, after: seconds, if:/unless: guards
  %a{redgem:experimental}
  def self.transition: (from: Symbol | Array[Symbol], to: Symbol, **untyped options) -> void
  # its states, by name
  %a{redgem:experimental}
  def self.states: () -> Hash[Symbol, Hash[Symbol, Symbol | Proc]]
  # its transitions, in the order they were declared
  %a{redgem:experimental}
  def self.transitions: () -> Array[untyped]
  # the state it is in (nil before its first frame)
  %a{redgem:experimental}
  def state: () -> (Symbol | nil)
  # the state it was in before
  %a{redgem:experimental}
  def previous_state: () -> (Symbol | nil)
  # seconds of game time in this state
  %a{redgem:experimental}
  def time_in_state: () -> Float
  # whether it is in one of these states
  %a{redgem:experimental}
  def in?: (*Symbol | String names) -> bool
  # an event: the first transition waiting for it that may be taken is; true when the state changed
  %a{redgem:experimental}
  def fire: (Symbol | String event, ?untyped payload) -> bool
  # goes to a state now, whatever the transitions say
  %a{redgem:experimental}
  def go: (Symbol | String name) -> bool
end

# The time of day in the game's world, on game time: what schedules follow.
%a{redgem:experimental}
module GameClock
  # the hour of the day, its minutes as a fraction: 0 up to 24
  %a{redgem:experimental}
  def self.hour: () -> Float
  # the minute of the hour
  %a{redgem:experimental}
  def self.minute: () -> Integer
  # whole minutes since midnight: 0 up to 1439
  %a{redgem:experimental}
  def self.minute_of_day: () -> Integer
  # the day it is, from 1
  %a{redgem:experimental}
  def self.day: () -> Integer
  # the time as "HH:MM"
  %a{redgem:experimental}
  def self.to_s: () -> String
  # sets the time of day in whole hours and minutes (and the day, from 1)
  %a{redgem:experimental}
  def self.set: (hour: Integer, ?minute: Integer, ?day: Integer) -> void
  # game seconds for each second of game time (60 unless said)
  %a{redgem:experimental}
  def self.speed: () -> Float
  # changes it (0 stops the clock)
  %a{redgem:experimental}
  def self.speed=: (Numeric value) -> Numeric
  # what to save: { seconds:, speed: }
  %a{redgem:experimental}
  def self.state: () -> Hash[Symbol, Float]
  # back to a saved state; nil (nothing saved yet) leaves the clock as it is
  %a{redgem:experimental}
  def self.restore: (Hash[Symbol | String, Numeric] | nil saved) -> void
  # seconds of the world's time since the first day began
  %a{redgem:experimental}
  def self.seconds: () -> Float
end

# A behaviour: an NPC's day, what it does from what time by the GameClock; its behaviours hear on_schedule(activity).
%a{redgem:experimental}
class Schedule < Behaviour
  # the activity it is time for, or nil
  %a{redgem:experimental}
  def current: () -> (Symbol | nil)
  # [[minute of the day, activity], ...] in the order of the day
  %a{redgem:experimental}
  def plan: () -> Array[[Integer, Symbol]]
  # changes the plan: { "06:00" => :work } or "06:00 work, ..."
  %a{redgem:experimental}
  def plan=: (Hash[String, Symbol | String] | String given) -> (Hash[String, Symbol | String] | String)
  # a plan as given, in the order of the day
  %a{redgem:experimental}
  def self.parse: (Hash[String, Symbol | String] | String given) -> Array[[Integer, Symbol]]
  # what a plan says for a minute of the day
  %a{redgem:experimental}
  def self.activity_at: (Array[[Integer, Symbol]] plan, Integer minute_of_day) -> (Symbol | nil)
  # "06:30" as minutes of the day (390)
  %a{redgem:experimental}
  def self.minute_of: (String time) -> Integer
end

# A behaviour: turns an NPC's head toward the nearest hero in range and in front, or toward its target.
%a{redgem:experimental}
class HeadLook < Behaviour
  # what it looks at instead of the heroes, or nil
  %a{redgem:experimental}
  def target: () -> (GameObject | Vector3 | nil)
  # sets it (nil: the heroes)
  %a{redgem:experimental}
  def target=: (GameObject | Vector3 | nil target) -> (GameObject | Vector3 | nil)
  # the nearest hero in range and in front of it, or nil
  %a{redgem:experimental}
  def nearest_hero: () -> (GameObject | nil)
  # the head's bone
  %a{redgem:experimental}
  def bone: () -> GameObject
  # meters to a hero (4 unless said)
  %a{redgem:experimental}
  def range: () -> Float
  # degrees off its forward a hero may be at, and the most the head turns (70 unless said)
  %a{redgem:experimental}
  def angle: () -> Float
end

# A behaviour: moves a speaker's mouth with the loudness of its voice, through a shape key (morph:) or a jaw bone (jaw:, angle:).
%a{redgem:experimental}
class VoiceMouth < Behaviour
  # moves the mouth with that sound (a handle of the :voice group) in place of the one it followed; a dialogue line's voice does it for its speaker
  %a{redgem:experimental}
  def follow: (Integer | nil handle) -> (Integer | nil)
  # how open the mouth is now, 0 to 1
  %a{redgem:experimental}
  def openness: () -> Float
  # how open a mouth is (0 to 1) for a voice of that loudness, all open from full
  %a{redgem:experimental}
  def self.openness_at: (Numeric loudness, Numeric full) -> Float
end

# The clip of a dialogue line's voice, playing from the speaker's head in the :voice group (made by the conversation shown).
%a{redgem:experimental}
class Dialogue::Voice
  # plays a line's clip from the speaker's head (with no place in the world for no speaker); nil when it does not play
  %a{redgem:experimental}
  def self.play: (String | Symbol name, GameObject | nil speaker) -> (Dialogue::Voice | nil)
  # the clip's sound handle
  %a{redgem:experimental}
  def handle: () -> (Integer | nil)
  # whether the clip still plays
  %a{redgem:experimental}
  def playing?: () -> bool
  # moves the clip to where the speaker's head is now
  %a{redgem:experimental}
  def follow: () -> void
  # where the clip plays from: the speaker's head, or the speaker
  %a{redgem:experimental}
  def place: () -> Vector3
  # stops the clip
  %a{redgem:experimental}
  def stop: () -> bool
end
