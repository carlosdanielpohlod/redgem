# Who uses what: the choice of a target, uses, and the game's handlers; over the network the host decides.
%a{redgem:experimental}
module Interaction
  # |actor, target| on every use (:interact), and as the focus comes (:focus) and goes (:blur)
  %a{redgem:experimental}
  def self.on: (Symbol event) { (GameObject, GameObject) -> void } -> void
  # the actor uses a target (an object or its Interactable) when it is in reach; asked of the host on a client
  %a{redgem:experimental}
  def self.interact: (GameObject actor, GameObject | Interactable target) -> bool
  # the Interactable an actor would use now, or nil (lenient: as the host judges a client's hero)
  %a{redgem:experimental}
